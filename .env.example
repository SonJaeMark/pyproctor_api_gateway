# .env.example
DEBUG=0
SECRET_KEY=replace-with-strong-django-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.onrender.com
DJANGO_SETTINGS_MODULE=config.settings

# JWT verification (must match the signing key/alg issued by auth_service)
JWT_SECRET=replace-with-shared-jwt-signing-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=pyproctor-auth-service

# Upstream Microservice URLs
AUTH_SERVICE_URL=https://auth-service-33w4.onrender.com
EXAM_SERVICE_URL=
GRADING_SERVICE_URL=
RESULTS_SERVICE_URL=

# Optional shared internal gateway secret for downstream services
GATEWAY_INTERNAL_SECRET=replace-with-internal-gateway-secret

# Rate limiting on /api/v1/auth/* (requests per window per client IP)
AUTH_RATE_LIMIT_REQUESTS=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Upstream HTTP timeout (seconds)
UPSTREAM_TIMEOUT_SECONDS=10
MAX_BODY_BYTES=2097152